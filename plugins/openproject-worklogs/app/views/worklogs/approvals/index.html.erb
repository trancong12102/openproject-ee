<% content_for :header_tags do %>
  <%= tag.link(rel: "stylesheet", href: OpenProject::Worklogs::Assets.path("worklogs.css")) %>
  <%= javascript_include_tag OpenProject::Worklogs::Assets.path("worklogs.js"), defer: true %>
<% end %>

<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { t("worklogs.approval.title") } %>
  <% header.with_description { t("worklogs.approval.description") } %>
  <% header.with_breadcrumbs(nil) %>
<% end %>

<div class="worklogs-page">
  <%= render(Worklogs::Approvals::QueueComponent.new(pending: @pending, decided: @decided)) %>
</div>
