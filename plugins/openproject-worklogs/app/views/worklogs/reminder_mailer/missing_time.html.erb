<p><%= t("worklogs.reminders.greeting", name: @user.firstname.presence || @user.name) %></p>

<p>
  <%= t("worklogs.reminders.body",
        week: t("worklogs.timesheet.week_number", number: @week.start_date.cweek),
        range: "#{I18n.l(@week.start_date, format: :long)} – #{I18n.l(@week.end_date, format: :long)}") %>
</p>

<ul>
  <li><%= t("worklogs.timesheet.daily_total") %>: <strong><%= worklogs_duration(@row.logged) %></strong></li>
  <li><%= t("worklogs.timesheet.capacity") %>: <strong><%= worklogs_duration(@row.capacity) %></strong></li>
  <li><%= t("worklogs.coverage.total_missing") %>: <strong><%= worklogs_duration(@row.missing) %></strong></li>
</ul>

<% if @row.empty_days.any? %>
  <p>
    <%= t("worklogs.reminders.empty_days",
          count: @row.empty_days.size,
          days: @row.empty_days.map { |date| I18n.l(date, format: :long) }.join(", ")) %>
  </p>
<% end %>

<p>
  <%= link_to(t("worklogs.reminders.open_timesheet"),
              worklogs_root_url(date: @week.to_param)) %>
</p>

<p><%= t("worklogs.reminders.footer") %></p>
