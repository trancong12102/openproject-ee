<%= component_wrapper do %>
  <div class="worklogs-controls" data-worklogs-controls>
    <div class="worklogs-controls--group">
      <%# Period ------------------------------------------------------------ %>
      <%# The arrows step the period itself, so any month, quarter or year is
          two clicks from wherever you are standing — no picker required. %>
      <div class="worklogs-stepper">
        <a class="worklogs-stepper--arrow" href="<%= previous_period_href %>"
           title="<%= previous_period_label %>" aria-label="<%= previous_period_label %>" rel="prev"></a>

        <details class="worklogs-drop -stepped" data-worklogs-drop>
          <summary class="worklogs-drop--chip -primary">
            <span class="worklogs-drop--label"><%= t("worklogs.reports.period") %></span>
            <span class="worklogs-drop--value"><%= query.period_label %></span>
            <% if period_caption %>
              <span class="worklogs-drop--caption"><%= period_caption %></span>
            <% end %>
          </summary>
          <div class="worklogs-drop--panel">
            <form method="get" action="<%= worklogs_reports_path %>">
              <%= worklogs_query_hidden_fields(query, except: %i[period from to]) %>
              <ul class="worklogs-drop--options">
                <% periods.each do |period| %>
                  <li>
                    <label class="worklogs-drop--option">
                      <input type="radio" name="period" value="<%= period %>" <%= "checked" if query.period == period %>>
                      <span><%= t("worklogs.reports.periods.#{period}") %></span>
                    </label>
                  </li>
                <% end %>
              </ul>
              <div class="worklogs-drop--actions">
                <button type="submit" class="worklogs-button -primary"><%= t("worklogs.reports.apply") %></button>
              </div>
            </form>

            <%# Its own form: a period is one answer, and three sets of controls
                sharing a submit button would send three of them. %>
            <p class="worklogs-drop--group"><%= t("worklogs.reports.pick_month") %></p>
            <form method="get" action="<%= worklogs_reports_path %>" class="worklogs-drop--inline">
              <%= worklogs_query_hidden_fields(query, except: %i[period from to]) %>
              <input type="hidden" name="period" value="month">
              <input type="month" name="from" value="<%= month_value %>"
                     aria-label="<%= t('worklogs.reports.pick_month') %>">
              <button type="submit" class="worklogs-button -primary"><%= t("worklogs.reports.apply") %></button>
            </form>

            <p class="worklogs-drop--group"><%= t("worklogs.reports.periods.custom") %></p>
            <form method="get" action="<%= worklogs_reports_path %>">
              <%= worklogs_query_hidden_fields(query, except: %i[period from to]) %>
              <input type="hidden" name="period" value="custom">
              <div class="worklogs-drop--dates">
                <label>
                  <span><%= t("worklogs.reports.from") %></span>
                  <input type="date" name="from" value="<%= query.from.iso8601 %>">
                </label>
                <label>
                  <span><%= t("worklogs.reports.to") %></span>
                  <input type="date" name="to" value="<%= query.to.iso8601 %>">
                </label>
              </div>
              <div class="worklogs-drop--actions">
                <button type="submit" class="worklogs-button -primary"><%= t("worklogs.reports.apply") %></button>
              </div>
            </form>
          </div>
        </details>

        <a class="worklogs-stepper--arrow -next" href="<%= next_period_href %>"
           title="<%= next_period_label %>" aria-label="<%= next_period_label %>" rel="next"></a>
      </div>

      <%# Filters ----------------------------------------------------------- %>
      <% filters.each do |filter| %>
        <details class="worklogs-drop" data-worklogs-drop>
          <summary class="worklogs-drop--chip <%= "-active" if selected_ids(filter).any? %>">
            <span class="worklogs-drop--label"><%= filter.label %></span>
            <span class="worklogs-drop--value"><%= chip_value(filter) %></span>
          </summary>
          <div class="worklogs-drop--panel">
            <form method="get" action="<%= worklogs_reports_path %>">
              <%= worklogs_query_hidden_fields(query, except: :"#{filter.name}_ids") %>
              <% if options_for(filter).size > 8 %>
                <input type="search" class="worklogs-drop--search" data-worklogs-drop-search
                       placeholder="<%= t('worklogs.reports.search_placeholder') %>"
                       aria-label="<%= t('worklogs.reports.search_placeholder') %>">
              <% end %>
              <% if options_for(filter).empty? %>
                <p class="worklogs-drop--empty"><%= t("worklogs.reports.no_options") %></p>
              <% else %>
                <ul class="worklogs-drop--options">
                  <% options_for(filter).each do |option| %>
                    <li data-worklogs-drop-item="<%= "#{option.label} #{option.caption}".downcase %>">
                      <label class="worklogs-drop--option">
                        <input type="checkbox" name="<%= filter.name %>_ids[]" value="<%= option.id %>"
                               <%= "checked" if selected_ids(filter).include?(option.id) %>>
                        <span>
                          <%= option.label %>
                          <% if option.caption %>
                            <em class="worklogs-drop--option-caption"><%= option.caption %></em>
                          <% end %>
                        </span>
                      </label>
                    </li>
                  <% end %>
                </ul>
              <% end %>
              <% if filter.note %>
                <p class="worklogs-drop--note"><%= filter.note %></p>
              <% end %>
              <div class="worklogs-drop--actions">
                <button type="submit" class="worklogs-button -primary"><%= t("worklogs.reports.apply") %></button>
                <% if selected_ids(filter).any? %>
                  <a class="worklogs-button" href="<%= clear_href(filter) %>"><%= t("worklogs.reports.clear") %></a>
                <% end %>
              </div>
            </form>
          </div>
        </details>
      <% end %>

      <%# Free text ---------------------------------------------------------- %>
      <details class="worklogs-drop" data-worklogs-drop>
        <summary class="worklogs-drop--chip <%= "-active" if query.text.present? %>">
          <span class="worklogs-drop--label"><%= t("worklogs.reports.comment_contains") %></span>
          <span class="worklogs-drop--value"><%= text_chip_value %></span>
        </summary>
        <div class="worklogs-drop--panel">
          <form method="get" action="<%= worklogs_reports_path %>">
            <%= worklogs_query_hidden_fields(query, except: :text) %>
            <label class="worklogs-drop--field">
              <span><%= t("worklogs.reports.comment_contains") %></span>
              <input type="search" name="text" value="<%= query.text %>"
                     placeholder="<%= t('worklogs.reports.comment_placeholder') %>">
            </label>
            <div class="worklogs-drop--actions">
              <button type="submit" class="worklogs-button -primary"><%= t("worklogs.reports.apply") %></button>
              <% if query.text.present? %>
                <a class="worklogs-button" href="<%= worklogs_report_path(query, text: nil) %>">
                  <%= t("worklogs.reports.clear") %>
                </a>
              <% end %>
            </div>
          </form>
        </div>
      </details>

      <% if query.filters? %>
        <a class="worklogs-controls--clear" href="<%= clear_all_href %>">
          <%= t("worklogs.reports.clear_all", count: query.filter_count) %>
        </a>
      <% end %>
    </div>

    <div class="worklogs-controls--group -end">
      <%# Grouping ---------------------------------------------------------- %>
      <details class="worklogs-drop" data-worklogs-drop>
        <summary class="worklogs-drop--chip -primary">
          <span class="worklogs-drop--label"><%= t("worklogs.reports.group_by") %></span>
          <span class="worklogs-drop--value"><%= grouping_summary %></span>
        </summary>
        <div class="worklogs-drop--panel -wide">
          <form method="get" action="<%= worklogs_reports_path %>">
            <%= worklogs_query_hidden_fields(query, except: %i[rows columns]) %>
            <label class="worklogs-drop--field">
              <span><%= t("worklogs.reports.rows_level", level: 1) %></span>
              <select name="rows[]">
                <% dimension_options.each do |dimension| %>
                  <option value="<%= dimension.key %>" <%= "selected" if row_key(0) == dimension.key %>>
                    <%= dimension.label %>
                  </option>
                <% end %>
              </select>
            </label>
            <label class="worklogs-drop--field">
              <span><%= t("worklogs.reports.rows_level", level: 2) %></span>
              <select name="rows[]">
                <option value=""><%= t("worklogs.reports.no_grouping") %></option>
                <% dimension_options.each do |dimension| %>
                  <option value="<%= dimension.key %>" <%= "selected" if row_key(1) == dimension.key %>>
                    <%= dimension.label %>
                  </option>
                <% end %>
              </select>
            </label>
            <label class="worklogs-drop--field">
              <span><%= t("worklogs.reports.columns") %></span>
              <select name="columns">
                <option value=""><%= t("worklogs.reports.no_columns") %></option>
                <% column_options.each do |dimension| %>
                  <option value="<%= dimension.key %>" <%= "selected" if query.column_key == dimension.key %>>
                    <%= dimension.label %>
                  </option>
                <% end %>
              </select>
            </label>
            <div class="worklogs-drop--actions">
              <button type="submit" class="worklogs-button -primary"><%= t("worklogs.reports.apply") %></button>
            </div>
          </form>
        </div>
      </details>

      <%# Measure ----------------------------------------------------------- %>
      <div class="worklogs-segmented" role="group" aria-label="<%= t('worklogs.reports.measure') %>">
        <% measures.each do |measure| %>
          <a class="worklogs-segmented--item <%= "-selected" if query.measure == measure %>"
             href="<%= worklogs_report_path(query, measure: measure) %>"
             <%= 'aria-current="true"'.html_safe if query.measure == measure %>>
            <%= t("worklogs.reports.measures.#{measure}") %>
          </a>
        <% end %>
      </div>

      <%# Export --------------------------------------------------------- %>
      <details class="worklogs-drop" data-worklogs-drop>
        <summary class="worklogs-drop--chip">
          <span class="worklogs-drop--value"><%= t("worklogs.reports.export") %></span>
        </summary>
        <div class="worklogs-drop--panel -wide">
          <p class="worklogs-drop--group"><%= t("worklogs.reports.exports.pivot_group") %></p>
          <ul class="worklogs-drop--options">
            <% pivot_exports.each do |export| %>
              <li>
                <a class="worklogs-drop--link" href="<%= export.href %>" download>
                  <span><%= export.label %></span>
                  <em><%= export.caption %></em>
                </a>
              </li>
            <% end %>
          </ul>
          <p class="worklogs-drop--group"><%= t("worklogs.reports.exports.detail_group") %></p>
          <ul class="worklogs-drop--options">
            <% detail_exports.each do |export| %>
              <li>
                <a class="worklogs-drop--link" href="<%= export.href %>" download>
                  <span><%= export.label %></span>
                  <em><%= export.caption %></em>
                </a>
              </li>
            <% end %>
          </ul>
        </div>
      </details>
    </div>
  </div>
<% end %>
