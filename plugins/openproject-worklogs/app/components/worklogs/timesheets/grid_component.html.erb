<%= component_wrapper do %>
  <div class="worklogs-grid <%= "-month" if month? %>"
       data-worklogs-grid
       data-update-url="<%= worklogs_cells_path %>"
       data-grid-url="<%= grid_url %>"
       data-entry-dialog-template="<%= entry_dialog_template %>"
       data-context="<%= cell_context %>"
       data-user-id="<%= user.id %>">

    <% if any_rows? %>
      <div class="worklogs-grid--scroller">
        <table class="worklogs-grid--table">
          <thead>
            <tr>
              <th scope="col" class="worklogs-grid--row-head">
                <span class="worklogs-grid--column-label"><%= t("worklogs.timesheet.work_package_column") %></span>
              </th>
              <% dates.each do |date| %>
                <th scope="col" class="<%= column_classes(date).join(' ') %>"
                    <%= "title=#{non_working_reason(date).label.inspect}".html_safe if non_working_reason(date) %>>
                  <% if week_start?(date) %>
                    <%# Thirty-one columns read as one undifferentiated smear
                        without something to count weeks by. %>
                    <span class="worklogs-grid--week-tag"><%= week_tag(date) %></span>
                  <% end %>
                  <span class="worklogs-grid--day-name"><%= worklogs_day_name(date) %></span>
                  <span class="worklogs-grid--day-number"><%= date.day %></span>
                  <span class="worklogs-grid--day-capacity">
                    <%= non_working_reason(date) ? non_working_short(date) : worklogs_hours_with_unit(capacity.hours_for(date)) %>
                  </span>
                </th>
              <% end %>
              <th scope="col" class="worklogs-grid--total-head">
                <span class="worklogs-grid--column-label"><%= t("worklogs.timesheet.total_column") %></span>
              </th>
            </tr>
          </thead>

          <% groups.each do |group| %>
            <tbody class="worklogs-grid--group">
              <tr class="worklogs-grid--group-row">
                <th scope="colgroup" colspan="<%= dates.size + 2 %>">
                  <span class="worklogs-grid--group-main">
                    <%= link_to group.project.name, project_path(group.project), class: "worklogs-grid--group-name" %>
                    <span class="worklogs-grid--group-count"><%= t("worklogs.timesheet.row_count", count: group.rows.size) %></span>
                  </span>
                  <span class="worklogs-grid--group-total"><%= worklogs_hours_with_unit(group.total) %></span>
                </th>
              </tr>

              <% group.rows.each do |row| %>
                <tr class="worklogs-grid--row" id="worklogs-row-<%= row.key %>" data-worklogs-row="<%= row.key %>">
                  <th scope="row" class="worklogs-grid--row-head">
                    <div class="worklogs-grid--row-main">
                      <div class="worklogs-grid--row-text">
                        <%# Core's own type + id + status line, so a row here reads
                            exactly like a work package anywhere else in the product. %>
                        <% if row.work_package? %>
                          <div class="worklogs-grid--row-info">
                            <%= render(WorkPackages::InfoLineComponent.new(work_package: row.entity, wrap: false)) %>
                          </div>
                        <% end %>
                        <div class="worklogs-grid--row-title">
                          <span class="worklogs-grid--row-subject" title="<%= row.subject %>"><%= row.subject %></span>
                          <% if row.activity %>
                            <span class="worklogs-grid--row-activity"><%= row.activity.name %></span>
                          <% end %>
                        </div>
                      </div>

                      <%# A Primer ActionMenu here would cost ~7.6 KB of markup per
                          row, which a 40-row week cannot afford — and it would
                          only repeat what is already one click away: the work
                          package is linked above and every cell has its own
                          detail button. All that is left is dropping an empty
                          row, and a row with hours is dropped by clearing its
                          cells, so no destructive action hides behind this. %>
                      <%= link_to "",
                                  remove_row_path(row),
                                  class: "worklogs-grid--row-remove #{'-hidden' unless removable?(row)}",
                                  title: remove_row_label(row),
                                  "aria-label": remove_row_label(row),
                                  data: { turbo: true, "turbo-method": :delete } %>
                    </div>
                  </th>

                  <% dates.each do |date| %>
                    <% cell = row.cell(date) %>
                    <td class="<%= cell_classes(row, cell).join(' ') %>">
                      <% if editable?(row, cell) %>
                        <input type="text"
                               class="worklogs-grid--cell-input"
                               inputmode="decimal"
                               autocomplete="off"
                               value="<%= worklogs_hours(cell.hours) %>"
                               aria-label="<%= t('worklogs.timesheet.cell_label', subject: row.subject, date: I18n.l(date, format: :long)) %>"
                               <%= tag.attributes(data: cell_data(row, cell)) %>>
                      <% else %>
                        <span class="worklogs-grid--cell-static" title="<%= cell_title(cell) %>">
                          <%= worklogs_hours(cell.hours) %>
                        </span>
                      <% end %>

                      <% if cell.comments.any? %>
                        <span class="worklogs-grid--cell-note" title="<%= cell.comments.join(' · ') %>" aria-hidden="true"></span>
                      <% end %>

                      <% if show_cell_dialog?(row, cell) %>
                        <%# Deliberately icon-free markup: at 7 cells × N rows an
                            inline <svg> per cell dominates the page weight, so the
                            plus/pencil glyphs are CSS masks the browser can also
                            swap when a cell gains or loses its entry. %>
                        <%= link_to "",
                                    cell_dialog_path(row, cell),
                                    class: "worklogs-grid--cell-detail #{'-empty' if cell.empty?}",
                                    tabindex: -1,
                                    title: cell_dialog_label(row, cell),
                                    "aria-label": cell_dialog_label(row, cell),
                                    data: {
                                      "turbo-stream": true,
                                      new_href: new_entry_dialog_path(row, cell),
                                      add_label: t("worklogs.timesheet.log_on", subject: row.subject,
                                                                                date: I18n.l(cell.date, format: :long)),
                                      edit_label: t("worklogs.timesheet.open_entry", subject: row.subject,
                                                                                     date: I18n.l(cell.date, format: :long))
                                    } %>
                      <% end %>
                    </td>
                  <% end %>

                  <td class="worklogs-grid--row-total" data-worklogs-row-total="<%= row.key %>">
                    <%= worklogs_hours(row.total) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          <% end %>

          <tfoot>
            <tr class="worklogs-grid--totals">
              <th scope="row"><%= t("worklogs.timesheet.daily_total") %></th>
              <% dates.each do |date| %>
                <td class="<%= daily_total_classes(date).join(' ') %>" data-worklogs-day-total="<%= date.iso8601 %>">
                  <%= worklogs_hours(timesheet.daily_total(date)) %>
                </td>
              <% end %>
              <td class="worklogs-grid--grand-total" data-worklogs-grand-total>
                <%= worklogs_hours_figure(timesheet.total) %>
              </td>
            </tr>
            <tr class="worklogs-grid--difference">
              <th scope="row"><%= t("worklogs.timesheet.difference") %></th>
              <% dates.each do |date| %>
                <td class="<%= difference_classes(date).join(' ') %>" data-worklogs-day-difference="<%= date.iso8601 %>">
                  <%= day_difference_label(date) %>
                </td>
              <% end %>
              <td class="worklogs-grid--grand-total <%= span_difference_class %>" data-worklogs-span-difference>
                <%= span_difference_label %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <%= render(Primer::Beta::Blankslate.new(border: false)) do |blankslate| %>
        <% blankslate.with_visual_icon(icon: "clock") %>
        <% blankslate.with_heading(tag: :h3).with_content(t("worklogs.timesheet.blank_heading")) %>
        <%# An empty sheet and a sheet emptied by a filter look identical, and
            only one of them is fixed by adding a row. %>
        <% blankslate.with_description do %>
          <%= t(timesheet.filtered? ? "worklogs.timesheet.blank_filtered" : "worklogs.timesheet.blank_description") %>
        <% end %>
        <% unless timesheet.locked? %>
          <% blankslate.with_primary_action(href: add_row_path,
                                            data: { "turbo-stream": true }).with_content(t("worklogs.timesheet.add_row")) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
