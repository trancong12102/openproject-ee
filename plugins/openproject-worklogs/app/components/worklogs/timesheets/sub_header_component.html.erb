<%= component_wrapper do %>
  <%= render(Primer::OpenProject::SubHeader.new) do |component| %>
    <% component.with_text { title } %>

    <% component.with_action_button_group do |group| %>
      <% group.with_button(icon: "chevron-left", tag: :a, **previous_attrs) %>
      <% group.with_button(icon: "chevron-right", tag: :a, **next_attrs) %>
    <% end %>

    <% component.with_action_button(tag: :a,
                                    href: today_href,
                                    leading_icon: :"op-calendar-day",
                                    label: I18n.t(:label_today)) do %>
      <%= I18n.t(:label_today_capitalized) %>
    <% end %>

    <% unless locked? %>
      <% component.with_action_button(tag: :a,
                                    href: add_row_href,
                                    data: { "turbo-stream": true },
                                    leading_icon: :plus,
                                    label: t("worklogs.timesheet.add_row")) do %>
        <%= t("worklogs.timesheet.add_row") %>
      <% end %>

      <% component.with_action_menu(icon_only: true,
                                  leading_icon: :"kebab-horizontal",
                                  label: t("worklogs.timesheet.more_actions")) do |menu| %>
      <% menu.with_item(tag: :a,
                        href: copy_previous_href,
                        label: copy_previous_label,
                        content_arguments: { data: { turbo: true, "turbo-method": :post } }) do |item| %>
        <% item.with_leading_visual_icon(icon: :copy) %>
          <% item.with_description.with_content(copy_previous_description) %>
        <% end %>
      <% end %>
    <% end %>

    <% if may_log? %>
      <% component.with_action_button(scheme: :primary,
                                      tag: :a,
                                      href: log_time_href,
                                      data: { "turbo-stream": true },
                                      leading_icon: :stopwatch,
                                      label: I18n.t(:button_log_time)) do %>
        <%= I18n.t(:button_log_time) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
